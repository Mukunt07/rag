generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum WorkspaceVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum DocumentType {
  PDF
  DOC
  DOCX
  TXT
  PPT
  PPTX
  XLS
  XLSX
  CSV
  IMAGE
  MARKDOWN
  RTF
  ZIP
  JSON
  XML
  HTML
  EML
  MSG
}

enum DocumentSource {
  UPLOAD
  GOOGLE_DRIVE
  ONEDRIVE
  DROPBOX
  NOTION
  GITHUB
  URL
}

enum StorageProvider {
  LOCAL
  CLOUDFLARE_R2
  AWS_S3
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  EXTRACTING
  CHUNKING
  EMBEDDING
  READY
  FAILED
}

enum ProcessingStage {
  QUEUED
  DOWNLOADING
  PARSING
  EXTRACTING
  CHUNKING
  EMBEDDING
  INDEXING
  COMPLETED
  FAILED
}

enum ProcessingStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ChatRole {
  user
  assistant
  system
}

enum GenerationType {
  summary
  notes
  quiz
  flashcards
  mindmap
  timeline
  translation
}

// ---------------------------------------------------------
// BETTER AUTH CORE TABLES
// ---------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  accounts      Account[]
  
  preference    UserPreference?
  workspaces    Workspace[]
  documents     Document[]
  chatSessions  ChatSession[]
  usageMetrics  UsageMetric[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("verification")
}

// ---------------------------------------------------------
// APPLICATION TABLES
// ---------------------------------------------------------

model UserPreference {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme        String   @default("system")
  language     String   @default("en")
  timezone     String   @default("UTC")
  defaultModel String?  @map("default_model")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model Workspace {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name        String
  description String?
  icon        String?
  visibility  WorkspaceVisibility @default(PRIVATE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  settings      WorkspaceSetting?
  documents     Document[]
  chatSessions  ChatSession[]
  aiGenerations AiGeneration[]
  savedArtifacts SavedArtifact[]
  usageMetrics  UsageMetric[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceSetting {
  id             String   @id @default(uuid())
  workspaceId    String   @unique @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  defaultModel   String?  @map("default_model")
  temperature    Float?
  chunkSize      Int?     @map("chunk_size")
  embeddingModel String?  @map("embedding_model")
  systemPrompt   String?  @map("system_prompt")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("workspace_settings")
}

model Document {
  id               String   @id @default(uuid())
  workspaceId      String   @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedById     String   @map("uploaded_by")
  uploadedBy       User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  
  parentDocumentId String?  @map("parent_document_id")
  parentDocument   Document? @relation("DocumentVersions", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  childVersions    Document[] @relation("DocumentVersions")
  version          Int      @default(1)

  title            String
  originalFilename String   @map("original_filename")
  documentType     DocumentType @map("document_type")
  source           DocumentSource @default(UPLOAD)
  storageProvider  StorageProvider @map("storage_provider")
  storageKey       String   @map("storage_key")
  mimeType         String?  @map("mime_type")
  
  originalSize     Int      @default(0) @map("original_size")
  storageSize      Int?     @map("storage_size")
  compressionRatio Float?   @map("compression_ratio")
  checksum         String?

  language         String?
  hasImages        Boolean  @default(false) @map("has_images")
  hasTables        Boolean  @default(false) @map("has_tables")
  
  status           DocumentStatus @default(UPLOADED)
  
  pageCount        Int?     @map("page_count")
  wordCount        Int?     @map("word_count")
  characterCount   Int?     @map("character_count")
  chunkCount       Int?     @map("chunk_count")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  processingJobs   ProcessingJob[]
  documentChunks   DocumentChunk[]
  aiGenerations    AiGeneration[]
  savedArtifacts   SavedArtifact[]
  usageMetrics     UsageMetric[]

  @@index([workspaceId])
  @@index([status])
  @@map("documents")
}

model ProcessingJob {
  id           String          @id @default(uuid())
  documentId   String          @map("document_id")
  document     Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  stage        ProcessingStage
  status       ProcessingStatus @default(PENDING)
  progress     Float           @default(0)
  errorMessage String?         @map("error_message")
  
  retryCount   Int             @default(0) @map("retry_count")
  lastError    String?         @map("last_error")
  failedStage  ProcessingStage? @map("failed_stage")
  
  startedAt    DateTime?       @map("started_at")
  completedAt  DateTime?       @map("completed_at")

  @@index([documentId])
  @@map("processing_jobs")
}

model DocumentChunk {
  id             String   @id @default(uuid())
  documentId     String   @map("document_id")
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex     Int      @map("chunk_index")
  content        String
  tokenCount     Int      @map("token_count")
  vectorId       String   @map("vector_id")
  embeddingModel String   @map("embedding_model")
  
  pageNumber     Int?     @map("page_number")
  sectionTitle   String?  @map("section_title")

  createdAt      DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("document_chunks")
}

model ChatSession {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String   @map("created_by")
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  title       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  messages     ChatMessage[]
  usageMetrics UsageMetric[]

  @@index([workspaceId])
  @@map("chat_sessions")
}

model ChatMessage {
  id         String      @id @default(uuid())
  sessionId  String      @map("session_id")
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       ChatRole
  content    String
  tokenCount Int?        @map("token_count")
  model      String?
  
  citations  Json?
  metadata   Json?

  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("chat_messages")
}

model AiGeneration {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId     String?  @map("document_id") 
  document       Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  
  prompt         String
  output         Json
  generationType GenerationType @map("generation_type")
  model          String
  modelVersion   String?  @map("model_version")
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  temperature    Float?
  latencyMs      Int?     @map("latency_ms")
  
  createdAt      DateTime @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  savedArtifacts SavedArtifact[]

  @@index([documentId])
  @@map("ai_generations")
}

model SavedArtifact {
  id            String       @id @default(uuid())
  generationId  String?      @map("generation_id")
  generation    AiGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  workspaceId   String       @map("workspace_id")
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId    String?      @map("document_id")
  document      Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  
  artifactType  GenerationType @map("artifact_type")
  title         String
  payload       Json
  metadata      Json?
  isFavorite    Boolean      @default(false) @map("is_favorite")
  
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  @@index([workspaceId])
  @@map("saved_artifacts")
}

model UsageMetric {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String   @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId    String?  @map("document_id")
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  chatSessionId String?  @map("chat_session_id")
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  
  provider      String
  model         String
  requestType   String   @map("request_type")
  
  inputTokens   Int      @map("input_tokens")
  outputTokens  Int      @map("output_tokens")
  totalTokens   Int      @map("total_tokens")
  latencyMs     Int      @map("latency_ms")
  cost          Float?
  
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("usage_metrics")
}
